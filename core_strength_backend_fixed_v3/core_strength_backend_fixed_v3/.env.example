APP_NAME=CORE STRENGTH API
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000
TIMEZONE=Asia/Ho_Chi_Minh

# XAMPP MySQL mặc định thường dùng root không mật khẩu.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/gym_db?charset=utf8mb4

# Hãy đổi 2 khóa này trước khi chạy thật.
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARACTERS
QR_SECRET_KEY=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_QR_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
QR_TOKEN_EXPIRE_SECONDS=30
PASSWORD_RESET_OTP_MINUTES=10

# Dùng dấu phẩy để ngăn cách nhiều origin. Trong môi trường dev có thể để *.
CORS_ORIGINS=*

OUTBOX_ENABLED=true
OUTBOX_POLL_SECONDS=1.0
OUTBOX_BATCH_SIZE=100

UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://127.0.0.1:8000
MAX_AVATAR_SIZE_MB=5
